# Xcode / build artifacts
DerivedDataMCP/
DerivedData/
build/
*.xcarchive
*.log

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# StoreKit config lives in ChillMate/ChillMate.storekit; ignore a stray root copy
/ChillMate.storekit

# Swift Package Manager
.swiftpm/
.build/

# CocoaPods / Carthage (if ever used)
Pods/
Carthage/Build/

# Secrets / signing — never commit these
*.p8
*.mobileprovision
*.p12
*.entitlements.dump

# Device-build DerivedData
DerivedDataDevice/

# Stray shell-redirect artifacts (a file literally named "-" was committed once)
/-

# Python bytecode from the scripts/ checks
__pycache__/
*.pyc

# xcresult bundles written by the CI test steps into the workspace
TestResults/

# Python bytecode from tools/
__pycache__/
*.pyc
