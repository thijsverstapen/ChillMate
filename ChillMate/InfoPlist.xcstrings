    "Log Chill" : {
      "comment" : "Home-screen Quick Action title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chill eintragen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log Chill"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar Chill"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noter un Chill"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chill loggen"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Shown when the user adds a person from Contacts to a log or STI notification.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate lässt dich deine Vertrauensperson oder eine Person für einen privaten Eintrag aus deinen Kontakten auswählen. Es sieht nur die Person, die du auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate lets you pick your trusted contact, or a partner for a private log, from your contacts. It only sees the person you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate te deja elegir tu contacto de confianza, o una pareja para un registro privado, de tus contactos. Solo ve a la persona que eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate te laisse choisir ton contact de confiance, ou un·e partenaire pour une entrée privée, dans tes contacts. Il ne voit que la personne que tu choisis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate laat je je vertrouwenscontact, of een partner voor een privélog, uit je contacten kiezen. Het ziet alleen de persoon die je kiest."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Shown before the first Face ID unlock of the app lock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate nutzt Face ID, um deine sensiblen Daten zu schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate uses Face ID to help protect your sensitive information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate usa Face ID para ayudar a proteger tu información sensible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate utilise Face ID pour protéger vos informations sensibles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate gebruikt Face ID om je gevoelige gegevens te beschermen."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Shown when requesting permission to read from Apple Health.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate liest deinen Schlaf, um einzutragen, wie lange du nach einer Nacht geschlafen hast, und deine Herzfrequenz und Herzfrequenzvariabilität für deine Erholungs-Punktzahl und deine Apple Watch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate reads your sleep to fill in how long you slept after a night, and your heart rate and heart rate variability for your recovery score and your Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate lee tu sueño para anotar cuánto dormiste después de una noche, y tu frecuencia cardiaca y su variabilidad para tu puntuación de recuperación y tu Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate lit ton sommeil pour indiquer combien de temps tu as dormi après une nuit, ainsi que ta fréquence cardiaque et sa variabilité pour ton score de rétablissement et ton Apple Watch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate leest je slaap om in te vullen hoe lang je na een nacht hebt geslapen, en je hartslag en hartslagvariabiliteit voor je herstelscore en je Apple Watch."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Shown when requesting permission to write to Apple Health.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate speichert sexuelle Aktivität und Schlaf für die Nächte, die du einträgst, deine Atemübungen und deine Stimmung in der Nachsorge. Nichts darüber, was du genommen oder geschrieben hast, geht mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate writes sexual activity and sleep for the nights you log, your breathing sessions, and your aftercare mood. Nothing about what you took or what you wrote goes with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate guarda la actividad sexual y el sueño de las noches que registras, tus sesiones de respiración y tu estado de ánimo en los cuidados posteriores. Nada sobre lo que tomaste ni lo que escribiste va con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate enregistre l’activité sexuelle et le sommeil des nuits que tu notes, tes séances de respiration et ton humeur dans les soins après. Rien sur ce que tu as pris ni sur ce que tu as écrit n’y est joint."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate schrijft seksuele activiteit en slaap voor de nachten die je logt, je ademhalingssessies en je stemming in de nazorg. Niets over wat je nam of wat je schreef gaat mee."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Shown when requesting location access while the app is in use.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate nutzt deinen Standort nur, wenn du darum bittest: für einen Eintrag oder für eine Nachricht, die du gerade sendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate uses your location only when you ask: to add it to a log, or to put it in a message you are sending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate usa tu ubicación solo cuando tú lo pides: para añadirla a un registro o para ponerla en un mensaje que estás enviando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate utilise ta position seulement quand tu le demandes : pour l’ajouter à une entrée, ou pour la mettre dans un message que tu envoies."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate gebruikt je locatie alleen als jij erom vraagt: om hem aan een log toe te voegen, of om hem mee te sturen in een bericht dat je verstuurt."
          }
        }
      }
    },
