    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Shown when requesting location access.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate nutzt deinen Standort nur, wenn du ihn selbst zu einem privaten Eintrag hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate uses your location if you choose to add it to a private log entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate usa tu ubicación solo si decides añadirla a un registro privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate utilise votre position uniquement si vous choisissez de l'ajouter à une entrée privée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate gebruikt je locatie alleen als je die zelf aan een privé-item toevoegt."
          }
        }
      }
    },
