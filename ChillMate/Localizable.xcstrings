    "Hydration and cooling matter, especially if sleep, food, or breaks have been limited.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flüssigkeit und Abkühlen sind wichtig, besonders wenn Schlaf, Essen oder Pausen knapp waren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hidratación y refrescarse importan, especialmente si el sueño, la comida o los descansos han sido limitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hydratation et le rafraîchissement comptent, surtout si le sommeil, la nourriture ou les pauses ont été limités."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hydratatie en afkoeling zijn belangrijk, zeker als slaap, eten of pauzes beperkt waren."
          }
        }
      }
    },
