          "stringUnit": {
            "state": "translated",
            "value": "Die Punktzahl basiert auf deinem letzten Eintrag: Schlaf, Nachsorge, Substanzen, Erholungs-Serie und Apple Watch-HRV, falls verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación se basa en tu registro más reciente: sueño, cuidados posteriores, sustancias, racha de recuperación y HRV del Apple Watch si está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
