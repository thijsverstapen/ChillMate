        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une décision posée peut apaiser une soirée bruyante."
          }
        }
      }
    },
    "Your worth was never on the line tonight." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
