            "value" : "Du schaffst Raum für Erholung."
          }
        }
      }
    },
    "You are not just tracking habits. You are learning what you need." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je houdt niet alleen gewoontes bij. Je leert wat je nodig hebt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No solo estás registrando hábitos. Estás aprendiendo lo que necesitas."
