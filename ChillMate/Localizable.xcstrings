        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux revenir au plan même après t'en être éloigné."
          }
        }
      }
    },
    "Being gentle with yourself is part of taking this seriously." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mild zijn voor jezelf hoort bij dit serieus nemen."
