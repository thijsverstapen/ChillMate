        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una respiración estable es un punto para empezar de nuevo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiger Atemzug ist ein Ort, um neu zu beginnen."
