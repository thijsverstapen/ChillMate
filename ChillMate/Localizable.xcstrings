        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du darfst stolz darauf sein, den ruhigeren Weg zu wählen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux être fier d'avoir choisi le chemin plus calme."
          }
        }
      }
    },
    "The way you treat yourself tonight echoes into tomorrow." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe je vanavond met jezelf omgaat, werkt door tot morgen."
