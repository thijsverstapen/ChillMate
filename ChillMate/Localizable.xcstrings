          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralentir est une compétence, et tu l'exerces."
          }
        }
      }
    },
    "Your worth does not drop when a streak does." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je waarde daalt niet als een reeks daalt."
