        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu recuperación no se cancela por un día difícil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Genesung wird nicht durch einen schweren Tag aufgehoben."
