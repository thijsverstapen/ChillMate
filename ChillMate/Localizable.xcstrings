        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux être la personne qui veille sur toi."
          }
        }
      }
    },
    "A boundary held gently is still a boundary held." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een grens die zacht wordt bewaakt, is nog steeds bewaakt."
