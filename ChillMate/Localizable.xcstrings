      }
    },
    "The morning is easier when you are kind to tonight." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ochtend is makkelijker als je vriendelijk bent voor vanavond."
