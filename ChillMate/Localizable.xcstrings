          }
        }
      }
    },
    "Your future self is listening to the choice you make now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein zukünftiges Ich hört auf die Entscheidung, die du jetzt triffst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu yo futuro está escuchando la decisión que tomas ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton toi futur écoute le choix que tu fais maintenant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toekomstige zelf luistert naar de keuze die je nu maakt."
          }
        }
      }
    },
    "Your future self is shaped by small choices like this one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein zukünftiges Ich wird von kleinen Entscheidungen wie dieser geformt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu yo futuro se forma con pequeñas decisiones como esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton toi futur se construit avec de petits choix comme celui-ci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toekomstige zelf wordt gevormd door kleine keuzes zoals deze."
          }
        }
      }
    },
    "Your honesty here is building trust with yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ehrlichkeit hier baut Vertrauen zu dir selbst auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu honestidad aquí construye confianza contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton honnêteté ici construit la confiance avec toi-même."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerlijkheid hier bouwt vertrouwen met jezelf op."
          }
        }
      }
    },
    "Your honesty with yourself is worth more than a perfect record.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ehrlichkeit dir selbst gegenüber ist mehr wert als eine perfekte Bilanz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu honestidad contigo vale más que un historial perfecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton honnêteté envers toi-même vaut plus qu'un parcours parfait."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerlijkheid naar jezelf is meer waard dan een perfect overzicht."
          }
        }
      }
    },
    "Your last 3 months, at a glance": {
      "extractionState": "stale",
      "localizations": {
