    "Comfort is not the same as safety. You get to choose safety.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bequemlichkeit ist nicht dasselbe wie Sicherheit. Du darfst Sicherheit wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comodidad no es lo mismo que la seguridad. Puedes elegir la seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le confort n'est pas la sécurité. Tu peux choisir la sécurité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfort is niet hetzelfde als veiligheid. Jij mag voor veiligheid kiezen."
          }
        }
      }
    },
    "Coming back after a rough stretch takes real courage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer harten Phase zurückzukommen erfordert echten Mut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver después de una mala racha requiere verdadero valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir après une période difficile demande un vrai courage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugkomen na een zware periode vraagt echte moed."
          }
        }
      }
    },
    "Coming back to yourself is always possible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dir selbst zurückzukehren ist immer möglich."
