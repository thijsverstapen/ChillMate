    "Breathe slowly, drink water if safe, check your body, remember what was already logged, and ask whether waiting would protect tomorrow-you." : {
      "comment" : "A description of the purpose of a 10-minute pause.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe slowly, drink water if safe, check your body, remember what was already logged, and ask whether waiting would protect tomorrow-you."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem langzaam, drink water als dat veilig is, check je lichaam, herinner je wat al is gelogd en vraag je af of wachten de jij-van-morgen zou beschermen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira despacio, bebe agua si es seguro, revisa tu cuerpo, recuerda lo que ya registraste y pregúntate si esperar protegería a tu yo de mañana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme langsam, trink Wasser, wenn es sicher ist, achte auf deinen Körper, erinnere dich an das bereits Erfasste und frage dich, ob Warten dein Morgen-Ich schützen würde."
          }
        }
      }
    },
