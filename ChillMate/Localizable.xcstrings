        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No change reasons tagged yet. New logs now include stress, breakup, work pressure, loneliness, money, housing, conflict, and boredom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen veranderingsredenen getagd. Nieuwe logs bevatten nu stress, relatiebreuk, werkdruk, eenzaamheid, geld, huisvesting, conflict en verveling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
