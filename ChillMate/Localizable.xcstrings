          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onboarding-pagina %lld van %lld"
          }
        }
      }
    },
    "One calm breath can change the next few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Atemzug kann die nächsten Minuten verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respiración tranquila puede cambiar los próximos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une respiration calme peut changer les prochaines minutes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rustige ademhaling kan de komende minuten veranderen."
          }
        }
      }
    },
    "One glass of water, one deep breath, one honest moment. Start there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Glas Wasser, ein tiefer Atemzug, ein ehrlicher Moment. Fang da an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vaso de agua, una respiración profunda, un momento honesto. Empieza ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un verre d'eau, une respiration profonde, un moment honnête. Commence par là."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén glas water, één diepe ademhaling, één eerlijk moment. Begin daar."
          }
        }
      }
    },
    "One good breath is enough to begin again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein guter Atemzug genügt, um neu anzufangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una buena respiración basta para empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bonne respiration suffit pour recommencer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén goede ademhaling is genoeg om opnieuw te beginnen."
          }
        }
      }
    },
    "One honest check-in is worth more than a perfect plan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ehrlicher Check-in ist mehr wert als ein perfekter Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un check-in honesto vale más que un plan perfecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un check-in honnête vaut plus qu'un plan parfait."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén eerlijke check-in is meer waard dan een perfect plan."
          }
        }
      }
    },
    "One honest log, one water refill, one text to someone you trust. That is a full day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ehrlicher Eintrag, ein weiteres Glas Wasser, eine Nachricht an eine Vertrauensperson. Das ist ein voller Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro honesto, un vaso de agua más, un mensaje a alguien de confianza. Eso es un día completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un journal honnête, un verre d'eau de plus, un message à une personne de confiance. C'est une journée complète."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén eerlijke log, één keer water bijvullen, één bericht naar iemand die je vertrouwt. Dat is een volle dag."
          }
        }
      }
    },
    "One honest sentence to a friend can lighten a heavy night.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ehrlicher Satz an einen Freund kann einen schweren Abend erleichtern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase honesta a un amigo puede aligerar una noche pesada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase honnête à un ami peut alléger une soirée lourde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén eerlijke zin tegen een vriend kan een zware avond lichter maken."
          }
        }
      }
    },
    "One kind choice tends to make the next one easier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine freundliche Entscheidung macht die nächste meist leichter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisión amable suele facilitar la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un choix bienveillant rend souvent le suivant plus facile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén vriendelijke keuze maakt de volgende meestal makkelijker."
          }
        }
      }
    },
    "One of your selections can affect serotonin levels. Risk can increase with repeated use, heat, dehydration, or other medication.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine deiner Auswahlen kann den Serotoninspiegel beeinflussen. Das Risiko kann bei wiederholtem Konsum, Hitze, Dehydrierung oder anderen Medikamenten steigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una de tus selecciones puede afectar a los niveles de serotonina. El riesgo puede aumentar con el uso repetido, el calor, la deshidratación u otra medicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'une de tes sélections peut affecter les niveaux de sérotonine. Le risque peut augmenter avec un usage répété, la chaleur, la déshydratation ou d'autres médicaments."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van je keuzes kan de serotoninespiegel beïnvloeden. Het risico kan toenemen bij herhaald gebruik, hitte, uitdroging of andere medicatie."
          }
        }
      }
    },
    "One private timeline with logs, journal notes, plans, timers, and STI tests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine private Zeitleiste mit Einträgen, Tagebuchnotizen, Plänen, Timern und STI-Tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cronología privada con registros, notas del diario, planes, temporizadores y pruebas de ITS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chronologie privée avec les journaux, les notes de journal, les plans, les minuteurs et les tests IST."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén privétijdlijn met logs, dagboeknotities, plannen, timers en soa-tests."
          }
        }
      }
    },
    "One safer choice makes room for the next one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sicherere Entscheidung schafft Raum für die nächste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisión más segura abre espacio para la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un choix plus sûr fait de la place au suivant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén veiligere keuze maakt ruimte voor de volgende."
          }
        }
      }
    },
    "One steadier night can shift a whole week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhigere Nacht kann eine ganze Woche verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una noche más estable puede cambiar toda una semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nuit plus posée peut changer toute une semaine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rustigere nacht kan een hele week veranderen."
          }
        }
      }
    },
    "One steady breath is a place to start again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Atemzug ist ein Ort, um neu zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respiración estable es un punto para empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une respiration posée est un point pour recommencer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rustige ademhaling is een plek om opnieuw te beginnen."
          }
        }
      }
    },
    "One steady decision can quiet a noisy night.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige Entscheidung kann einen lauten Abend beruhigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisión firme puede calmar una noche ruidosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une décision posée peut apaiser une soirée bruyante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén stabiele beslissing kan een rumoerige avond stiller maken."
          }
        }
      }
    },
    "One thing that slows breathing is selected. Keep the dose low, leave long gaps, and stay with someone who knows what you took.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sache ist ausgewählt, die die Atmung verlangsamt. Halte die Dosis niedrig, lass lange Abstände und bleib bei jemandem, der weiß, was du genommen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One thing that slows breathing is selected. Keep the dose low, leave long gaps, and stay with someone who knows what you took."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una cosa seleccionada que ralentiza la respiración. Mantén la dosis baja, deja intervalos largos y quédate con alguien que sepa qué has tomado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un produit qui ralentit la respiration est sélectionné. Garde une dose faible, laisse de longs intervalles et reste avec quelqu'un qui sait ce que tu as pris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is één middel geselecteerd dat de ademhaling vertraagt. Houd de dosis laag, laat lange tussenpozen en blijf bij iemand die weet wat je hebt genomen."
          }
        }
      }
    },
    "One thing worth noticing today": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sache, die heute auffällt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cosa que vale la pena notar hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chose qui mérite d'être remarquée aujourd'hui"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén ding dat vandaag het opmerken waard is"
          }
        }
      }
    },
    "Only select what feels relevant. This is for spotting trends, not judging yourself.": {
      "comment": "A description of the What Changed input card.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle nur, was relevant erscheint. Das dient dazu, Trends zu erkennen, nicht dich zu verurteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only select what feels relevant. This is for spotting trends, not judging yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona solo lo que te parezca relevante. Esto es para detectar tendencias, no para juzgarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne sélectionne que ce qui te semble pertinent. C'est pour repérer des tendances, pas pour te juger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer alleen wat relevant voelt. Dit is om trends te zien, niet om jezelf te beoordelen."
          }
        }
      }
    },
