        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rétablissement est moins une ligne droite qu'une série de retours."
          }
        }
      }
    },
    "You can be proud of the help you reached for." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
