        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comer antes, no solo después, es una forma silenciosa de cuidado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorher zu essen, nicht nur danach, ist eine stille Form der Fürsorge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manger avant, et pas seulement après, est une forme discrète de soin."
