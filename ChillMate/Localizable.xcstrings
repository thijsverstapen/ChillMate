        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ritonavir o el cobicistat pueden aumentar los niveles de algunas sustancias y de la medicación para la disfunción eréctil. Pregunta a un médico o farmacéutico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ritonavir ou le cobicistat peuvent augmenter les niveaux de certaines substances et des médicaments contre les troubles de l'érection. Demande à un médecin ou à un pharmacien."
          }
