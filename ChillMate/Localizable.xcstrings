          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según tu calendario de pruebas, puede ser momento de una revisión. Hacerte pruebas de ITS con regularidad forma parte de cuidarte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut deinem Testplan könnte es Zeit für einen Check sein. Regelmäßige STI-Tests gehören dazu, gesund zu bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'après ton calendrier de tests, il est peut-être temps d'un contrôle. Faire des tests IST régulièrement fait partie du fait de prendre soin de toi."
          }
        }
      }
    },
    "Baseline means “usual for you,” not “good” or “bad.” The app uses this to show when something changes." : {
      "comment" : "A description of the meaning of \"baseline\" in the context of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baseline means “usual for you,” not “good” or “bad.” The app uses this to show when something changes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basislijn betekent 'gebruikelijk voor jou', niet 'goed' of 'slecht'. De app gebruikt dit om te tonen wanneer er iets verandert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Referencia» significa «lo normal para ti», no «bueno» ni «malo». La app lo usa para mostrar cuándo algo cambia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ausgangswert“ bedeutet „normal für dich“, nicht „gut“ oder „schlecht“. Die App nutzt das, um zu zeigen, wann sich etwas ändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Référence » signifie « ce qui est habituel pour toi », pas « bien » ni « mal ». L'app l'utilise pour montrer quand quelque chose change."
          }
        }
      }
    },
