        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir d'enregistrer honnêtement, c'est choisir de te connaître."
          }
        }
      }
    },
    "The pause button is always available to you." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
