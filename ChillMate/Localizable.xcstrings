            "state": "translated",
            "value": "On prend des nouvelles"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even checken"
          }
        }
      }
    },
    "Checking in is a way of staying on your own side.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzuchecken ist eine Art, auf deiner eigenen Seite zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer un check-in es una forma de seguir de tu propio lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire un point, c'est une façon de rester de ton côté."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inchecken is een manier om aan je eigen kant te blijven."
          }
        }
      }
    },
    "Checking in with yourself takes courage. You are doing that.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit sich selbst einzuchecken erfordert Mut. Du tust das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer un check-in contigo mismo requiere valor. Lo estás haciendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire un point avec toi-même demande du courage. Tu es en train de le faire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij jezelf inchecken vergt moed. Dat doe je nu."
          }
        }
      }
    },
