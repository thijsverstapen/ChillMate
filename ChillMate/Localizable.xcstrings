            "state": "translated",
            "value": "A Sunday-evening digest of your streak and score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen del domingo por la noche de tu racha y tu puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un récapitulatif du dimanche soir de ta série et de ton score."
          }
        },
        "nl": {
          "stringUnit": {
