        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu hora de finalización planificada ya ha pasado. Primero haz una pausa: ¿estás a salvo, con apoyo y sigues eligiendo lo que te protege mañana?"
