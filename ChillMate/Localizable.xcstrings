    "Call %@ for immediate danger, urgent medical help, fire, or a crime in progress. Say where you are and what happened." : {
      "comment" : "A card with a call-to-action button that lets users call an emergency number. The argument is the emergency number.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call %@ for immediate danger, urgent medical help, fire, or a crime in progress. Say where you are and what happened."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bel %@ bij direct gevaar, dringende medische hulp, brand of een misdrijf in uitvoering. Zeg waar je bent en wat er is gebeurd."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llama a %@ ante peligro inmediato, ayuda médica urgente, incendio o un delito en curso. Di dónde estás y qué ha pasado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruf %@ bei unmittelbarer Gefahr, dringender medizinischer Hilfe, Feuer oder einer laufenden Straftat. Sag, wo du bist und was passiert ist."
          }
        }
      }
    },
