        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du darfst dem entwachsen, was sich früher normal anfühlte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as le droit de dépasser ce qui te semblait normal avant."
          }
        }
      }
    },
    "Eating before, not just after, is a quiet form of care." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eten vooraf, niet alleen achteraf, is een stille vorm van zorg."
