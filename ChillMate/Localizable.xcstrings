          }
        }
      }
    },
    "You don't have to be doing great. How are you actually feeling?" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft het niet geweldig te doen. Hoe voel je je echt?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes que estar genial. ¿Cómo te sientes de verdad?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es muss dir nicht super gehen. Wie fühlst du dich wirklich?"
          }
        }
      }
    },
    "You don't have to have it all figured out. Steady is enough." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft niet alles uitgevogeld te hebben. Stabiel is genoeg."
