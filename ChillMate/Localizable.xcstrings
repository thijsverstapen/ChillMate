          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst stolz auf Entscheidungen sein, die sonst niemand je sehen wird."
          }
        }
      }
    },
    "You can delete logs, plans, STI tests, timers, risk checks, journal entries, and account data inside the app." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
