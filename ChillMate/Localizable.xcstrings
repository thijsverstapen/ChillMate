    "ChillMate is free for everyone. A tip is a small, completely optional way to say thanks." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate is gratis voor iedereen. Een fooi is een kleine, volledig optionele manier om bedankt te zeggen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
