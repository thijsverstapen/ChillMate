    "Mixing stimulants, depressants, poppers with erection medication, or unknown substances can change risk faster than expected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimulanzien, Dämpfungsmittel, Poppers mit Erektionsmedikamenten oder unbekannte Substanzen zu mischen kann das Risiko schneller verändern als erwartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezclar estimulantes, depresores, poppers con medicación para la erección o sustancias desconocidas puede cambiar el riesgo más rápido de lo esperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélanger des stimulants, des dépresseurs, des poppers avec des médicaments pour l'érection ou des substances inconnues peut modifier le risque plus vite que prévu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het combineren van stimulanten, kalmerende middelen, poppers met erectiemedicatie of onbekende middelen kan het risico sneller veranderen dan verwacht."
          }
        }
      }
    },
