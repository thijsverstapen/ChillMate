        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être doux avec toi fait partie du fait de prendre cela au sérieux."
          }
        }
      }
    },
    "You are allowed to want both rest and connection, in that order tonight." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
