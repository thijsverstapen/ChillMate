    "Pressure, fear, blackout, or being unable to respond means stop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druck, Angst, Blackout oder Reaktionsunfähigkeit bedeuten: aufhören."
          }
        },
        "es": {
