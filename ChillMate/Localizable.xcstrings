    "Your body remembers every kind decision you make, even the ones you forget." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lichaam onthoudt elke vriendelijke beslissing die je maakt, ook die je vergeet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuerpo recuerda cada decisión amable que tomas, incluso las que olvidas."
