    "Your profile stays private on this device. If iCloud Backup is on, ChillMate saves encrypted backup files to iCloud Drive.": {
      "comment": "A description of how your profile is backed up.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil bleibt auf diesem Gerät privat. Wenn das iCloud-Backup an ist, speichert ChillMate verschlüsselte Backup-Dateien in iCloud Drive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile stays private on this device. If iCloud Backup is on, ChillMate saves encrypted backup files to iCloud Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil permanece privado en este dispositivo. Si la copia en iCloud está activada, ChillMate guarda archivos de copia cifrados en iCloud Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton profil reste privé sur cet appareil. Si la sauvegarde iCloud est activée, ChillMate enregistre des fichiers de sauvegarde chiffrés sur iCloud Drive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je profiel blijft privé op dit apparaat. Als iCloud-back-up aanstaat, slaat ChillMate versleutelde back-upbestanden op in iCloud Drive."
          }
        }
      }
    },
    "Your profile, photo, medication notes, trusted contact, home address, settings, and preferences.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil, Foto, Medikamentennotizen, Vertrauenskontakt, Heimadresse, Einstellungen und Präferenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil, foto, notas de medicación, contacto de confianza, dirección de casa, ajustes y preferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton profil, ta photo, tes notes de médication, ton contact de confiance, ton adresse de domicile, tes réglages et tes préférences."
          }
        },
        "nl": {
