        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerlijk zijn over een zware avond is een eigen vorm van kracht."
          }
        }
      }
    },
    "Being kind to your body is not always comfortable. You are doing it anyway.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freundlich zu deinem Körper zu sein ist nicht immer angenehm. Du tust es trotzdem."
