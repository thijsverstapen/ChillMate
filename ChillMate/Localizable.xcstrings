    "Converts to GHB in the body and carries similar risks, especially with alcohol or sedatives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Körper zu GHB umgewandelt und birgt ähnliche Risiken, besonders mit Alkohol oder Beruhigungsmitteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se convierte en GHB en el cuerpo y conlleva riesgos similares, especialmente con alcohol o sedantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se transforme en GHB dans le corps et comporte des risques similaires, surtout avec de l'alcool ou des sédatifs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt in het lichaam omgezet in GHB en draagt vergelijkbare risico's, vooral met alcohol of kalmerende middelen."
          }
        }
      }
    },
    "Cooling down and catching your breath is doing something.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich abzukühlen und Luft zu holen ist auch etwas tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refrescarte y recuperar el aliento también es hacer algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rafraîchir et reprendre ton souffle, c'est déjà agir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afkoelen en op adem komen is ook iets doen."
          }
        }
      }
    },
