    "Unknown substances are harder to predict. Avoid mixing and seek help if something feels wrong." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onbekende middelen zijn moeilijker te voorspellen. Vermijd combineren en zoek hulp als iets niet goed voelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sustancias desconocidas son más difíciles de predecir. Evita mezclar y busca ayuda si algo no va bien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannte Substanzen sind schwerer einzuschätzen. Vermeide das Mischen und hol Hilfe, wenn sich etwas falsch anfühlt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les substances inconnues sont plus difficiles à prévoir. Évite les mélanges et demande de l'aide si quelque chose ne va pas."
          }
        }
      }
    },
    "Unknown substances with anything else" : {
      "localizations" : {
