    },
    "You are allowed to choose the version of tonight that you can rest after." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag de versie van vanavond kiezen waarna je kunt rusten."
