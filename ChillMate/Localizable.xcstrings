            "state": "translated",
            "value": "Tes limites ne sont pas un problème à régler. Ce sont des informations à respecter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je grenzen zijn geen probleem om op te lossen. Ze zijn informatie om te respecteren."
          }
        }
      }
    },
    "Your limits make your yes mean something.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Grenzen geben deinem Ja eine Bedeutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus límites hacen que tu sí signifique algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes limites donnent du sens à ton oui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je grenzen geven je ja betekenis."
          }
        }
      }
    },
    "Your message": {
