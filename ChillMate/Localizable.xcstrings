        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux être doux et tenir quand même ta parole envers toi."
          }
        }
      }
    },
    "A calm exit is a skill worth being proud of." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rustig vertrek is een vaardigheid om trots op te zijn."
