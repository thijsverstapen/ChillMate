            "state" : "translated",
            "value" : "Voor zorgen over soa, PrEP, PEP, medicatie, mentale gezondheid of middelen, neem contact op met een huisarts, GGD, apotheker, arts, hulpverlener of andere gekwalificeerde professional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para temas de ITS, PrEP, PEP, medicación, salud mental o sustancias, contacta con un médico de cabecera, el GGD, un farmacéutico, un clínico, un consejero u otro profesional cualificado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zu STI, PrEP, PEP, Medikamenten, psychischer Gesundheit oder Substanzen wende dich an Hausarzt, GGD, Apotheker, Ärztin, Beratung oder eine andere qualifizierte Fachperson."
          }
        },
        "fr" : {
          "stringUnit" : {
