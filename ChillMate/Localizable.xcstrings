    "Stimulant effects can strain the heart, reduce sleep, and increase impulsive decisions." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulant-effecten kunnen het hart belasten, slaap verminderen en impulsieve beslissingen vergroten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los efectos estimulantes pueden sobrecargar el corazón, reducir el sueño y aumentar las decisiones impulsivas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulierende Effekte können das Herz belasten, den Schlaf verringern und impulsive Entscheidungen begünstigen."
          }
        }
      }
    },
