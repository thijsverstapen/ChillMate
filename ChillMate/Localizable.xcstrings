          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciertos antidepresivos (IMAO) con MDMA, 3-MMC, cocaína o psicodélicos pueden ser peligrosos. Evítalo y busca consejo profesional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains antidépresseurs (IMAO) avec de la MDMA, de la 3-MMC, de la cocaïne ou des psychédéliques peuvent être dangereux. Évite ça et demande un avis professionnel."
