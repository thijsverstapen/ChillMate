    "This app can support safer decisions, but it cannot diagnose, treat, or replace emergency or professional medical care." : {
      "comment" : "A disclaimer for the clinical review layer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app can support safer decisions, but it cannot diagnose, treat, or replace emergency or professional medical care."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app kan veiligere beslissingen ondersteunen, maar kan geen diagnose stellen, behandelen of spoedeisende of professionele medische zorg vervangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app puede apoyar decisiones más seguras, pero no puede diagnosticar, tratar ni reemplazar la atención médica de emergencia o profesional."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App kann sicherere Entscheidungen unterstützen, aber sie kann keine Notfall- oder professionelle medizinische Versorgung diagnostizieren, behandeln oder ersetzen."
          }
        }
      }
    },
    "This Chill" : {
      "localizations" : {
        "nl" : {
