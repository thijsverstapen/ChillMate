        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes guardar una parte de tu vida solo para ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du darfst einen Teil deines Lebens nur für dich behalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as le droit de garder une partie de ta vie rien que pour toi."
          }
        }
      }
    },
    "A check-in is not a test you can fail." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een check-in is geen toets die je kunt zakken."
