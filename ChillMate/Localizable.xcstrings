        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sanft mit dir sein und das trotzdem ernst nehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux être doux avec toi et prendre cela au sérieux quand même."
          }
        }
      }
    },
    "Rest now so the next decision comes from a clearer place." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rust nu, zodat de volgende keuze uit een helderder plek komt."
          }
