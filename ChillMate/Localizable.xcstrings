    "Rest is not the same as giving up. It is part of how you recover.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhe ist nicht dasselbe wie Aufgeben. Sie gehört dazu, wie du dich erholst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descansar no es lo mismo que rendirse. Forma parte de cómo te recuperas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reposer n'est pas la même chose qu'abandonner. Cela fait partie de ta façon de récupérer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust is niet hetzelfde als opgeven. Het hoort bij hoe je herstelt."
          }
