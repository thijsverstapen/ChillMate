    "Add names only if it helps you remember who to contact later. Phone numbers are used for the STI warning message shortcut." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add names only if it helps you remember who to contact later. Phone numbers are used for the STI warning message shortcut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg alleen namen toe als het je helpt te onthouden wie je later moet bereiken. Telefoonnummers worden gebruikt voor de soa-waarschuwingssnelkoppeling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade nombres solo si te ayuda a recordar a quién contactar más tarde. Los números de teléfono se usan para el acceso directo del mensaje de aviso de ITS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Namen nur hinzu, wenn es dir hilft, dich zu erinnern, wen du später kontaktieren willst. Telefonnummern werden für den Kurzbefehl der STI-Warnnachricht verwendet."
          }
        }
      }
    },
