        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar tu resumen privado, recordatorios, avisos de cuidados posteriores, seguimientos de ITS, accesos directos de emergencia y reflexiones de bienestar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deine private Übersicht, Erinnerungen, Nachsorge-Impulse, STI-Nachverfolgungen, Notfall-Kurzbefehle und Wohlbefindens-Reflexionen anzuzeigen."
          }
        }
      }
    },
    "To sync with Apple Health only for categories you approve in iOS settings." : {
