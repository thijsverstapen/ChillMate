        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine sanft gehaltene Grenze ist trotzdem eine gehaltene Grenze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une limite tenue avec douceur reste une limite tenue."
          }
        }
      }
    },
    "You are allowed to feel okay about an early goodnight." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag je oké voelen bij een vroege goedenacht."
