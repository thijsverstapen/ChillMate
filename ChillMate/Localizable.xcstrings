        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un check-in maintenant peut t'éviter une conversation plus difficile plus tard."
          }
        }
      }
    },
    "Your body keeps going because of small kindnesses like water and rest." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
