          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir le repos plutôt qu'une heure de plus est un vrai choix."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust kiezen boven nog een uur is een echte keuze."
          }
        }
      }
    },
    "Choosing to log honestly is choosing to know yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrlich zu protokollieren heißt, dich selbst kennenzulernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir registrar con honestidad es elegir conocerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir d'enregistrer honnêtement, c'est choisir de te connaître."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiezen om eerlijk te loggen is kiezen om jezelf te kennen."
          }
        }
      }
    },
    "Choosing water right now is a kind thing to do for yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
