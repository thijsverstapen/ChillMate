    "It is okay to have complicated feelings about where you are right now." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is oké om ingewikkelde gevoelens te hebben over waar je nu staat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está bien tener sentimientos complicados sobre dónde estás ahora mismo."
