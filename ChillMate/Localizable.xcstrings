          }
        }
      }
    },
    "Select at least one substance or add medication to see a risk check.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens eine Substanz oder füge Medikamente hinzu, um einen Risiko-Check zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona al menos una sustancia o añade medicación para ver una comprobación de riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne au moins une substance ou ajoute un médicament pour voir une vérification de risque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer minstens één middel of voeg medicatie toe om een risicocheck te zien."
          }
        }
      }
    },
    "Select medication, substances, and timing to see common safety signals. It never marks a combination as safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Medikamente, Substanzen und Zeitpunkt, um häufige Sicherheitssignale zu sehen. Eine Kombination wird nie als sicher markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona medicación, sustancias y momento para ver señales de seguridad comunes. Nunca marca una combinación como segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne médication, substances et moment pour voir les signaux de sécurité courants. Cela ne marque jamais une combinaison comme sûre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer medicatie, middelen en timing om veelvoorkomende veiligheidssignalen te zien. Het bestempelt een combinatie nooit als veilig."
          }
        }
      }
    },
    "Send a small confidence boost for recovery, substance-free days, and strong daily scores.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einen kleinen Mutmacher für Erholung, substanzfreie Tage und hohe Tagespunktzahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un pequeño impulso de confianza por la recuperación, los días sin sustancias y las puntuaciones diarias altas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un petit regain de confiance pour le rétablissement, les jours sans substances et les bons scores quotidiens."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een kleine steun in de rug voor herstel, middelenvrije dagen en sterke dagscores."
          }
        }
      }
