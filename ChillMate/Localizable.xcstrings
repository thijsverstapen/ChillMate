    "Converts to GHB in the body and carries similar risks, especially with alcohol or sedatives." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt in het lichaam omgezet in GHB en draagt vergelijkbare risico's, vooral met alcohol of kalmerende middelen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se convierte en GHB en el cuerpo y conlleva riesgos similares, especialmente con alcohol o sedantes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird im Körper zu GHB umgewandelt und birgt ähnliche Risiken, besonders mit Alkohol oder Beruhigungsmitteln."
          }
        }
      }
    },
    "Could not seal the encrypted backup archive." : {
