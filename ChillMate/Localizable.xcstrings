        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo te tratas esta noche resuena en el mañana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du dich heute Abend behandelst, hallt bis morgen nach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La façon dont tu te traites ce soir se prolonge jusqu'à demain."
          }
        }
      }
    },
    "You are allowed to stop reading the room and listen to yourself." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag stoppen met de kamer lezen en naar jezelf luisteren."
