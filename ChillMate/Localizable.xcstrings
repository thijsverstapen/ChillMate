        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: früher gehen, vorher essen, App-Dates nach Mitternacht vermeiden"
          }
        }
      }
    },
    "Example: no stimulant-related Chills for two weeks" : {
