    "Check in with yourself. Are the people around you still feeling safe to you?" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check bij jezelf in. Voelen de mensen om je heen nog steeds veilig voor je?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz un check-in contigo. ¿Las personas a tu alrededor te siguen pareciendo seguras?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach einen Check-in mit dir. Fühlen sich die Menschen um dich herum noch sicher für dich an?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais un point avec toi-même. Les personnes autour de toi te semblent-elles toujours sûres ?"
          }
        }
      }
    },
    "Check your temperature. Are you warm enough? Too warm? Drink something." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je temperatuur. Heb je het warm genoeg? Te warm? Drink iets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu temperatura. ¿Tienes suficiente calor? ¿Demasiado? Bebe algo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Temperatur. Ist dir warm genug? Zu warm? Trink etwas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie ta température. As-tu assez chaud ? Trop chaud ? Bois quelque chose."
          }
        }
      }
