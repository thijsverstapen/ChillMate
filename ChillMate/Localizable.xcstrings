    "A private, on-device summary": {
      "comment": "Title of a weekly reflection card.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine private Zusammenfassung, nur auf dem Gerät"
