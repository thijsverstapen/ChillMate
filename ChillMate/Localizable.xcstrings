          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre la app en el selector de apps y mientras se graba o duplica tu pantalla, para que un vistazo rápido nunca revele tu registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque l'app dans le sélecteur d'apps et pendant l'enregistrement ou la recopie de ton écran, pour qu'un coup d'œil ne révèle jamais ton journal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergt de app in de app-kiezer en terwijl je scherm wordt opgenomen of gedeeld, zodat een snelle blik je logboek nooit onthult."
          }
        }
      }
    },
