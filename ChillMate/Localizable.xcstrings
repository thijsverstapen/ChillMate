          "stringUnit": {
            "state": "translated",
            "value": "For STI testing, sexual health questions, or treatment that is not an emergency, contact %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pruebas de ITS, dudas de salud sexual o tratamiento no urgente, contacta con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les tests IST, les questions de santé sexuelle ou un traitement non urgent, contacte %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor soa-testen, vragen over seksuele gezondheid of niet-spoedeisende behandeling, neem contact op met %@."
          }
        }
      }
    },
    "For STI, PrEP, PEP, medication, mental-health, or substance concerns, contact a GP, sexual-health service, pharmacist, clinician, counselor, or other qualified professional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Fragen zu STI, PrEP, PEP, Medikamenten, psychischer Gesundheit oder Substanzen wende dich an einen Arzt, eine Beratungsstelle für sexuelle Gesundheit, eine Apotheke, eine Fachkraft, einen Berater oder eine andere qualifizierte Fachperson."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dudas sobre ITS, PrEP, PEP, medicación, salud mental o sustancias, contacta con un médico, un servicio de salud sexual, una farmacia, personal clínico, un consejero u otro profesional cualificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toute question sur les IST, la PrEP, la PEP, les médicaments, la santé mentale ou les substances, contacte un médecin, un service de santé sexuelle, une pharmacie, un soignant, un conseiller ou un autre professionnel qualifié."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor vragen over soa's, PrEP, PEP, medicatie, mentale gezondheid of middelen, neem contact op met een huisarts, soa-poli, apotheek, zorgverlener, hulpverlener of andere gekwalificeerde professional."
          }
        }
      }
    },
    "For example sertraline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel Sertralin"
          }
