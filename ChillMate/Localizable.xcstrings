    "Starts a ChillMate check-in timer for a substance, with a Live Activity on the Lock Screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen ChillMate-Check-in-Timer für eine Substanz, mit einer Live-Aktivität auf dem Sperrbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a ChillMate check-in timer for a substance, with a Live Activity on the Lock Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un temporizador de seguimiento de ChillMate para una sustancia, con una actividad en vivo en la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un minuteur de suivi ChillMate pour une substance, avec une activité en direct sur l'écran verrouillé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een ChillMate-checktimer voor een middel, met een Live Activiteit op je toegangsscherm."
          }
        }
      }
    },
