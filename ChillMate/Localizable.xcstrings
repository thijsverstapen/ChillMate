        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta valeur ne baisse pas quand une série s'arrête."
          }
        }
      }
    },
    "One kind choice tends to make the next one easier." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén vriendelijke keuze maakt de volgende meestal makkelijker."
