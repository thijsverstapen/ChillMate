    },
    "You are allowed to feel proud of staying in tonight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst stolz darauf sein, heute Abend zu Hause zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes sentirte orgulloso de quedarte en casa esta noche."
          }
