        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Grenzen gehören gerade immer noch dir. Daran hat sich nichts geändert."
          }
        }
      }
    },
    "Your data is protected by default. You can also create an encrypted backup file that only you can open. Handy if you ever reinstall or switch phones." : {
      "comment" : "A description of the default encryption of user data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is protected by default. You can also create an encrypted backup file that only you can open. Handy if you ever reinstall or switch phones."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens zijn standaard beschermd. Je kunt ook een versleuteld back-upbestand maken dat alleen jij kunt openen. Handig als je ooit herinstalleert of van telefoon wisselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos están protegidos por defecto. También puedes crear un archivo de copia cifrado que solo tú puedes abrir. Práctico si alguna vez reinstalas o cambias de teléfono."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten sind standardmäßig geschützt. Du kannst auch eine verschlüsselte Backup-Datei erstellen, die nur du öffnen kannst. Praktisch, falls du neu installierst oder das Handy wechselst."
          }
        }
