    "Enable only the categories you want ChillMate to use. Apple still manages final access in system privacy settings.": {
      "comment": "A description of the granular health permissions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere nur die Kategorien, die ChillMate nutzen soll. Den endgültigen Zugriff verwaltet weiterhin Apple in den System-Datenschutzeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable only the categories you want ChillMate to use. Apple still manages final access in system privacy settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa solo las categorías que quieres que use ChillMate. Apple sigue gestionando el acceso final en los ajustes de privacidad del sistema."
          }
        },
        "fr": {
          "stringUnit": {
