    },
    "ChillMate and its maker are not liable in any way for any decision, action, or outcome based on the app. Always confirm anything important with a qualified professional or official service." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate en de maker zijn op geen enkele manier aansprakelijk voor beslissingen, acties of uitkomsten op basis van de app. Bevestig belangrijke zaken altijd bij een gekwalificeerde professional of officiële dienst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate y su creador no se hacen responsables en modo alguno de ninguna decisión, acción o resultado basado en la app. Confirma siempre lo importante con un profesional cualificado o un servicio oficial."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate und sein Entwickler haften in keiner Weise für Entscheidungen, Handlungen oder Folgen, die auf der App beruhen. Bestätige Wichtiges immer mit einer qualifizierten Fachperson oder einer offiziellen Stelle."
          }
        }
      }
    },
    "ChillMate avoids calling combinations safe. It shows risk signals and source links to help you make more informed choices." : {
      "comment" : "A note that describes how ChillMate avoids calling combinations safe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate avoids calling combinations safe. It shows risk signals and source links to help you make more informed choices."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate noemt combinaties niet veilig. Het toont risicosignalen en bronlinks om je te helpen beter geïnformeerde keuzes te maken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate evita calificar las combinaciones como seguras. Muestra señales de riesgo y enlaces a fuentes para ayudarte a tomar decisiones más informadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillMate vermeidet es, Kombinationen als sicher zu bezeichnen. Es zeigt Risikosignale und Quellenlinks, damit du fundiertere Entscheidungen treffen kannst."
          }
        }
      }
    },
