          }
        }
      }
    },
    "A calm exit is a skill worth being proud of.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Abgang ist eine Fähigkeit, auf die man stolz sein darf."
