        }
      }
    },
    "A recent log may need quick sexual-health advice before %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aktueller Eintrag braucht eventuell schnellen Rat zur sexuellen Gesundheit vor %@."
          }
        },
        "es": {
