        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto se refiere a la pantalla de inicio del iPhone. El botón rojo de salida cierra ChillMate rápidamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ist der iPhone-Home-Bildschirm gemeint. Der rote Beenden-Knopf schließt ChillMate schnell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
