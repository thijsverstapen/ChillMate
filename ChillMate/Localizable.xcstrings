    "Chill, skipped Chill, sleep, aftercare? Small check, future-you says thanks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chill, ausgelassener Chill, Schlaf, Nachsorge? Kleiner Check, dein zukünftiges Ich sagt danke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chill, skipped Chill, sleep, aftercare? Small check, future-you says thanks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Chill, Chill omitido, sueño, cuidado posterior? Una comprobación rápida; tu yo futuro te lo agradece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chill, Chill ignoré, sommeil, récupération ? Petite vérification, ton futur toi te dira merci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chill, overgeslagen Chill, slaap, nazorg? Kleine check, je toekomstige zelf zegt bedankt."
          }
        }
      }
    },
    "ChillMate": {
      "comment": "The name of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChillMate"
