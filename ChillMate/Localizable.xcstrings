      }
    },
    "These details keep your overview and timer estimates personal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These details keep your overview and timer estimates personal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze gegevens houden je overzicht en timerschattingen persoonlijk."
