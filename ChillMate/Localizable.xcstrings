        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiger Körper trifft klarere Entscheidungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un corps calme fait des choix plus clairs."
