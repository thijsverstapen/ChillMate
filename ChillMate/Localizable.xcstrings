        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre soin de toi en privé reste un vrai soin."
          }
        }
      }
    },
    "You can start over at any hour, not just in the morning." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
