        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta valeur n'a jamais été en jeu ce soir."
          }
        }
      }
    },
    "You can come back to the plan even after stepping away from it." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
