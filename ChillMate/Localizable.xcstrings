        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een hele week verandert hoe je lichaam kan rusten."
          }
        }
      }
    },
    "A gentle no is still a complete sentence.": {
      "localizations": {
        "de": {
          "stringUnit": {
