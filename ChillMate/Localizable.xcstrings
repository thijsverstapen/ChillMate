    "I am stopping now" : {
      "comment" : "A button that stops the user from continuing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am stopping now"
          }
