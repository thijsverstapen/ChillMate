          "stringUnit": {
            "state": "translated",
            "value": "Preguntar por un amigo también es una forma de mirar por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre des nouvelles d'un ami est aussi une façon de prendre soin de toi."
