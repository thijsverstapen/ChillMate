        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mag je goed voelen over een gewone avond."
          }
        }
      }
    },
    "You are allowed to feel okay about an early goodnight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
