        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos detalles mantienen tu resumen y las estimaciones de los temporizadores personalizados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Details halten deine Übersicht und Timer-Schätzungen persönlich."
          }
        }
      }
    },
    "These settings prepare the iPhone side for Apple Watch features: hydration reminders, elevated heart-rate warnings, haptic breathing, discreet check-ins, timer visibility, and future stress/temperature signals." : {
      "comment" : "A description of the companion app preferences.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These settings prepare the iPhone side for Apple Watch features: hydration reminders, elevated heart-rate warnings, haptic breathing, discreet check-ins, timer visibility, and future stress/temperature signals."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze instellingen bereiden de iPhone-kant voor op Apple Watch-functies: hydratatieherinneringen, waarschuwingen bij verhoogde hartslag, haptische ademhaling, discrete check-ins, timerzichtbaarheid en toekomstige stress-/temperatuursignalen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes preparan la parte del iPhone para las funciones del Apple Watch: recordatorios de hidratación, avisos de frecuencia cardíaca elevada, respiración háptica, check-ins discretos, visibilidad de temporizadores y futuras señales de estrés/temperatura."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen bereiten die iPhone-Seite für Apple Watch-Funktionen vor: Trink-Erinnerungen, Warnungen bei erhöhtem Herzschlag, haptische Atmung, diskrete Check-ins, Timer-Sichtbarkeit und künftige Stress-/Temperatursignale."
          }
        }
      }
    },
