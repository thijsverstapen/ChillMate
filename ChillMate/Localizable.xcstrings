    },
    "You are allowed to feel proud without anyone clapping.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst stolz sein, ohne dass jemand klatscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes sentirte orgulloso sin que nadie aplauda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as le droit d'être fier sans que personne n'applaudisse."
