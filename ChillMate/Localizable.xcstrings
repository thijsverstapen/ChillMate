            "value": "Een patroon om op te merken"
          }
        }
      }
    },
    "A pause gives your future self a chance to weigh in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Pause gibt deinem zukünftigen Ich die Chance, mitzureden."
          }
