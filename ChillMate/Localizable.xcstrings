          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: Ich kann meinen Vertrauenskontakt anrufen, eine Fahrt bestellen oder mit einer Freundin gehen"
          }
        }
      }
    },
    "Example: leave earlier, eat first, avoid app dates after midnight" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
