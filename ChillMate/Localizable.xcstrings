    "On Friday and Saturday nights (12 to 6 am), a discreet passive check-in with one-tap “I'm safe” or “Get help”. Sent when a session is most likely.": {
      "comment": "Toggle for enabling or disabling weekend night check-ins.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Nächten von Freitag und Samstag (0 bis 6 Uhr) ein diskreter, passiver Check mit „Mir geht es gut“ oder „Hilfe holen“ per Tipp. Wird dann gesendet, wenn eine Session am wahrscheinlichsten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Friday and Saturday nights (12 to 6 am), a discreet passive check-in with one-tap “I'm safe” or “Get help”. Sent when a session is most likely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de viernes y sábado (de 00:00 a 6:00), una comprobación discreta y pasiva con «Estoy bien» o «Necesito ayuda» en un toque. Se envía cuando una sesión es más probable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits de vendredi et samedi (minuit à 6 h), une vérification discrète et passive avec « Je suis en sécurité » ou « Besoin d'aide » en un geste. Envoyée quand une session est la plus probable."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op vrijdag- en zaterdagnacht (van 0 tot 6 uur) een discrete, passieve check met één tik voor “Ik ben veilig” of “Hulp nodig”. Verstuurd wanneer een sessie het waarschijnlijkst is."
          }
        }
      }
    },
    "On PrEP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt PrEP"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On PrEP"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomando PrEP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous PrEP"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op PrEP"
          }
        }
      }
    },
    "On weekend nights (12 to 6 am), a discreet “you okay?” with one-tap help.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Wochenendnächten (0 bis 6 Uhr) ein diskretes „Alles okay?“ mit Hilfe per Tipp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On weekend nights (12 to 6 am), a discreet “you okay?” with one-tap help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de fin de semana (de 00:00 a 6:00), un discreto «¿estás bien?» con ayuda en un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nuits de week-end (minuit à 6 h), un discret « ça va ? » avec de l'aide en un geste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In weekendnachten (van 0 tot 6 uur) een discrete “gaat het?” met hulp op één tik."
          }
        }
      }
    },
    "Onboarding page %lld of %lld": {
      "comment": "A label that describes the current onboarding page.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
