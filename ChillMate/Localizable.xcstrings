        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basislijn betekent 'gebruikelijk voor jou', niet 'goed' of 'slecht'. De app gebruikt dit om te tonen wanneer er iets verandert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
