        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuerpo te agradecerá el agua que bebas esta noche."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Körper wird dir für das Wasser danken, das du heute Abend trinkst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton corps te remerciera pour l'eau que tu bois ce soir."
          }
        }
      }
    },
    "A boundary you keep tonight teaches you that you can." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een grens die je vanavond bewaakt, leert je dat je het kunt."
