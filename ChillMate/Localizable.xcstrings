        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine freundliche Entscheidung macht die nächste meist leichter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un choix bienveillant rend souvent le suivant plus facile."
          }
        }
      }
    },
    "You can be gentle with yourself and still take this seriously." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt lief zijn voor jezelf en dit toch serieus nemen."
