        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una salida tranquila es una habilidad de la que enorgullecerse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiger Abgang ist eine Fähigkeit, auf die man stolz sein darf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un départ calme est une compétence dont on peut être fier."
