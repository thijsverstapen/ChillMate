    "Optional, but helpful. You can call or message this person from Emergency, Panic support, and Safe Route." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional, but helpful. You can call or message this person from Emergency, Panic support, and Safe Route."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel maar nuttig. Je kunt deze persoon bellen of berichten vanuit Noodgeval, Paniekhulp en Veilige route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional, pero útil. Puedes llamar o enviar un mensaje a esta persona desde Emergencia, Apoyo de pánico y Ruta segura."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional, aber hilfreich. Du kannst diese Person aus Notfall, Panik-Hilfe und Sicherer Heimweg anrufen oder anschreiben."
          }
        }
      }
    },
    "Optional. Add it if you want reminders or easier planning." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Voeg het toe als je herinneringen of makkelijker plannen wilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Añádelo si quieres recordatorios o una planificación más fácil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Füge es hinzu, wenn du Erinnerungen oder einfachere Planung möchtest."
          }
        }
      }
    },
    "Optional. Tag anything that played a role so patterns are easier to notice later." : {
      "comment" : "A description of the optional trigger field.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Tag anything that played a role so patterns are easier to notice later."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Tag alles wat een rol speelde, zodat patronen later makkelijker op te merken zijn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Etiqueta cualquier cosa que haya influido para que los patrones sean más fáciles de notar después."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Tagge alles, was eine Rolle gespielt hat, damit Muster später leichter auffallen."
          }
        }
      }
    },
