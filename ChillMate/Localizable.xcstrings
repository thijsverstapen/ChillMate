    "Free, confidential support if you might hurt yourself or cannot stay safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose, vertrauliche Unterstützung, wenn du dir wehtun könntest oder dich nicht sicher halten kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyo gratuito y confidencial si podrías hacerte daño o no puedes mantenerte a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutien gratuit et confidentiel si tu pourrais te faire du mal ou ne peux pas rester en sécurité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis, vertrouwelijke hulp als je jezelf zou kunnen pijn doen of niet veilig kunt blijven."
          }
        }
      }
    },
    "Fuel for a whole new feature": {
      "localizations": {
