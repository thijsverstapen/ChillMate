        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mañana es más fácil cuando eres amable con esta noche."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Morgen ist leichter, wenn du heute Abend gut zu dir bist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le matin est plus facile quand tu es bienveillant envers ce soir."
          }
        }
      }
    },
    "You are allowed to keep some of your life just for you." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag een deel van je leven alleen voor jezelf houden."
