    "Stimulant" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulant"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimulante"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulans"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulant"
          }
        }
      }
    },
    "Stimulant effects can strain the heart, reduce sleep, and increase impulsive decisions." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulant-effecten kunnen het hart belasten, slaap verminderen en impulsieve beslissingen vergroten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los efectos estimulantes pueden sobrecargar el corazón, reducir el sueño y aumentar las decisiones impulsivas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulierende Effekte können das Herz belasten, den Schlaf verringern und impulsive Entscheidungen begünstigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les effets stimulants peuvent solliciter le cœur, réduire le sommeil et augmenter les décisions impulsives."
          }
        }
      }
    },
    "Stimulant medication" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulantmedicatie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medicación estimulante"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien-Medikament"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Médicament stimulant"
          }
        }
      }
    },
    "Stimulant overload" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulant-overbelasting"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrecarga de estimulantes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien-Überlastung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surcharge de stimulants"
          }
        }
      }
    },
    "stimulant overload, too little rest, dehydration, or intense sensory input" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "stimulant-overbelasting, te weinig rust, uitdroging of intense zintuiglijke prikkels"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sobrecarga de estimulantes, poco descanso, deshidratación o estímulos sensoriales intensos"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien-Überlastung, zu wenig Ruhe, Dehydrierung oder intensive Sinnesreize"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "surcharge de stimulants, trop peu de repos, déshydratation ou stimulations sensorielles intenses"
          }
        }
      }
    },
    "Stimulant/empathogen effects can include warmth, jaw tension, overheating, and a next-day dip." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulant-/empathogeen-effecten kunnen warmte, kaakspanning, oververhitting en een dip de volgende dag omvatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los efectos estimulantes/empatógenos pueden incluir calor, tensión mandibular, sobrecalentamiento y un bajón al día siguiente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien-/Empathogen-Effekte können Wärme, Kieferanspannung, Überhitzung und ein Tief am nächsten Tag umfassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les effets stimulants/empathogènes peuvent inclure de la chaleur, une tension de la mâchoire, une surchauffe et une baisse le lendemain."
          }
        }
      }
    },
    "Stimulants can mask GBL effects, making it harder to notice when a dose is too high." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanten kunnen de effecten van GBL maskeren, waardoor het moeilijker is te merken wanneer een dosis te hoog is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estimulantes pueden enmascarar los efectos del GBL, dificultando notar cuándo una dosis es demasiado alta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien können die Wirkung von GBL überdecken, sodass schwerer zu bemerken ist, wann eine Dosis zu hoch ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les stimulants peuvent masquer les effets du GBL, rendant plus difficile de remarquer qu'une dose est trop élevée."
          }
        }
      }
    },
    "Stimulants can mask GHB effects, making it harder to notice when a dose is too high. This increases the risk of accidental overdose." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanten kunnen de effecten van GHB maskeren, waardoor het moeilijker is te merken wanneer een dosis te hoog is. Dit verhoogt het risico op een onbedoelde overdosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estimulantes pueden enmascarar los efectos del GHB, dificultando notar cuándo una dosis es demasiado alta. Esto aumenta el riesgo de sobredosis accidental."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien können die Wirkung von GHB überdecken, sodass schwerer zu bemerken ist, wann eine Dosis zu hoch ist. Das erhöht das Risiko einer versehentlichen Überdosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les stimulants peuvent masquer les effets du GHB, rendant plus difficile de remarquer qu'une dose est trop élevée. Cela augmente le risque de surdose accidentelle."
          }
        }
      }
    },
    "Stimulants, alcohol, heat, dancing, and long sessions can push dehydration and overheating risk up." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanten, alcohol, hitte, dansen en lange sessies kunnen het risico op uitdroging en oververhitting verhogen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estimulantes, el alcohol, el calor, bailar y las sesiones largas pueden aumentar el riesgo de deshidratación y sobrecalentamiento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimulanzien, Alkohol, Hitze, Tanzen und lange Sessions können das Risiko für Dehydrierung und Überhitzung erhöhen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
