    "Calm mode: answer only what matters right now." : {
      "comment" : "A label displayed under the toggle to turn on \"Calm mode\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm mode: answer only what matters right now."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
