    "Nitrates, nicorandil, or riociguat with Viagra, Kamagra, or poppers can cause a severe blood pressure drop. Do not combine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitrate, Nicorandil oder Riociguat mit Viagra, Kamagra oder Poppers können einen schweren Blutdruckabfall auslösen. Nicht kombinieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nitratos, el nicorandil o el riociguat con Viagra, Kamagra o poppers pueden provocar una caída grave de la tensión. No los combines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nitrates, le nicorandil ou le riociguat avec du Viagra, du Kamagra ou des poppers peuvent provoquer une chute sévère de la tension. Ne pas combiner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitraten, nicorandil of riociguat met Viagra, Kamagra of poppers kunnen een ernstige bloeddrukdaling veroorzaken. Niet combineren."
          }
        }
      }
    },
