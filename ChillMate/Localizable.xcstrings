        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mag trots zijn op één goede beslissing."
          }
        }
      }
    },
    "You are allowed to be the calm one tonight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst heute Abend der Ruhige sein."
          }
        },
        "es": {
