        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un endroit sans honte pour réduire, arrêter ou simplement t'accorder une période plus calme. Un redémarrage est une information, pas un échec."
          }
        }
      }
    },
