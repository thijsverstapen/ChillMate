        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un check-in n'est pas un test que tu peux rater."
          }
        }
      }
    },
    "You can want closeness and still keep your limits." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt nabijheid willen en toch je grenzen bewaren."
