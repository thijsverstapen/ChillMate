        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne respiration suffit pour recommencer."
          }
        }
      }
    },
    "You can be the person who looks out for you." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de persoon zijn die voor jou zorgt."
