        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux vouloir de la proximité et garder tes limites."
          }
        }
      }
    },
    "Rest is productive in its own quiet way." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rust is productief op zijn eigen stille manier."
