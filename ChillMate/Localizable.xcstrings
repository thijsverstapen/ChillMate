        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du darfst die Version von heute Abend wählen, nach der du ruhen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as le droit de choisir la version de ce soir après laquelle tu pourras te reposer."
          }
        }
      }
    },
    "Caring for your body is never a waste of a night." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor je lichaam zorgen is nooit een verspilde avond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidar tu cuerpo nunca es una noche perdida."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deinen Körper zu sorgen ist nie ein verschwendeter Abend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre soin de ton corps n'est jamais une soirée gâchée."
          }
        }
      }
    },
    "You can be soft and still keep your word to yourself." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt zacht zijn en toch je woord aan jezelf houden."
