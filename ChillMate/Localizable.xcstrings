    "Patterns are shown as neutral signals, never as judgment. Everything here is calculated locally from your logs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster werden als neutrale Signale gezeigt, nie als Urteil. Alles hier wird lokal aus deinen Einträgen berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones se muestran como señales neutrales, nunca como juicio. Todo aquí se calcula localmente a partir de tus registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les schémas sont présentés comme des signaux neutres, jamais comme un jugement. Tout ici est calculé localement à partir de tes journaux."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
