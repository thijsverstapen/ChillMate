            "value": "Una frase sencilla de check-in puede facilitar proteger tus límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase de check-in simple peut faciliter la protection de tes limites."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eenvoudige check-in-zin kan grenzen makkelijker te bewaken maken."
          }
        }
      }
    },
    "A simple history of backups, restores, lock choices, and app privacy settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einfacher Verlauf von Backups, Wiederherstellungen, Sperroptionen und App-Datenschutzeinstellungen."
