    "Today's small care is tomorrow's steadier ground.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleine Fürsorge von heute ist der festere Boden von morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pequeño cuidado de hoy es el suelo más firme de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le petit soin d'aujourd'hui est le terrain plus stable de demain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kleine zorg van vandaag is de stevigere bodem van morgen."
          }
        }
      }
    },
