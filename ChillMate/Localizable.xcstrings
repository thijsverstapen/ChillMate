    "Short-acting vasodilator. Avoid with erectile dysfunction medication because blood pressure can drop sharply." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortwerkende vaatverwijder. Vermijd met erectiemedicatie omdat de bloeddruk scherp kan dalen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasodilatador de acción corta. Evítalo con medicación para la disfunción eréctil porque la presión arterial puede bajar bruscamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzwirksamer Gefäßerweiterer. Vermeide es mit Mitteln gegen erektile Dysfunktion, da der Blutdruck stark abfallen kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasodilatateur à action courte. À éviter avec les médicaments contre la dysfonction érectile, car la tension artérielle peut chuter brusquement."
          }
        }
      }
    },
