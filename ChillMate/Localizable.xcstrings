    "This plan has several risk points. Slow down, remove unknowns, avoid mixing, and consider postponing or talking to someone you trust." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit plan heeft meerdere risicopunten. Vertraag, verwijder onbekenden, vermijd combineren en overweeg uit te stellen of met iemand te praten die je vertrouwt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plan tiene varios puntos de riesgo. Ve más despacio, elimina lo desconocido, evita mezclar y considera posponerlo o hablar con alguien de confianza."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plan hat mehrere Risikopunkte. Mach langsamer, beseitige Unbekanntes, vermeide das Mischen und überlege, es zu verschieben oder mit einer Vertrauensperson zu sprechen."
          }
        }
      }
    },
