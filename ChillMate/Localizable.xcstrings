    "Strength and contents can differ between batches. If you feel pressure to continue, pause and consider support before doing anything else." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterkte en samenstelling kunnen per batch verschillen. Als je druk voelt om door te gaan, pauzeer dan en overweeg hulp voor je iets anders doet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La potencia y el contenido pueden variar entre lotes. Si sientes presión para continuar, haz una pausa y considera buscar apoyo antes de hacer nada más."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stärke und Inhalt können zwischen Chargen variieren. Wenn du Druck spürst weiterzumachen, pausiere und ziehe Unterstützung in Betracht, bevor du etwas anderes tust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puissance et la composition peuvent varier d'un lot à l'autre. Si tu ressens une pression pour continuer, fais une pause et envisage un soutien avant de faire quoi que ce soit d'autre."
          }
        }
      }
    },
