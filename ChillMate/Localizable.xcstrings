        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Körper erinnert sich an jede freundliche Entscheidung, die du triffst, auch an die, die du vergisst."
          }
        }
      }
    },
    "Your boundaries are still yours right now. Nothing has changed that." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je grenzen zijn op dit moment nog steeds van jou. Niets heeft dat veranderd."
