    "Being gentle with yourself is part of taking this seriously.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanft mit dir zu sein gehört dazu, das ernst zu nehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser amable contigo es parte de tomarte esto en serio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être doux avec toi fait partie du fait de prendre cela au sérieux."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mild zijn voor jezelf hoort bij dit serieus nemen."
          }
        }
