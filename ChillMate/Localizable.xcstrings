    "Locks your private files even when the app is closed. Useful if your phone is ever lost or stolen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt deine privaten Dateien auch bei geschlossener App. Praktisch, falls dein Handy verloren geht oder gestohlen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea tus archivos privados incluso con la app cerrada. Útil si alguna vez pierdes el teléfono o te lo roban."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille tes fichiers privés même quand l'app est fermée. Utile si ton téléphone est un jour perdu ou volé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendelt je privébestanden zelfs als de app gesloten is. Handig als je telefoon ooit verloren of gestolen raakt."
          }
        }
      }
    },
