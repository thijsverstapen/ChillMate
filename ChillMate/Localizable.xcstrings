          }
        }
      }
    },
    "Lock ChillMate with Face ID or a PIN and keep local data encrypted on this iPhone. The red stop button on Home instantly hides the screen; tap it to resume.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperre ChillMate mit Face ID oder einer PIN und halte lokale Daten auf diesem iPhone verschlüsselt. Die rote Stopp-Taste auf Start blendet den Bildschirm sofort aus; tippe darauf, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock ChillMate with Face ID or a PIN and keep local data encrypted on this iPhone. The red stop button on Home instantly hides the screen; tap it to resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea ChillMate con Face ID o un PIN y mantén los datos locales cifrados en este iPhone. El botón rojo de parada en Inicio oculta la pantalla al instante; tócalo para reanudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille ChillMate avec Face ID ou un PIN et garde les données locales chiffrées sur cet iPhone. Le bouton stop rouge sur Accueil masque l'écran instantanément ; touche-le pour reprendre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendel ChillMate met Face ID of een pincode en houd lokale gegevens versleuteld op deze iPhone. De rode stopknop op Thuis verbergt het scherm meteen; tik erop om te hervatten."
          }
        }
      }
    },
    "Lock ChillMate with Face ID or a PIN, keep everything encrypted on this iPhone, and hide the screen in one tap. It offers reflection and safety information from verified sources. It is not medical advice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperre ChillMate mit Face ID oder einer PIN, halte alles verschlüsselt auf diesem iPhone und verbirg den Bildschirm mit einem Tippen. Es bietet Reflexion und Sicherheitsinformationen aus geprüften Quellen. Es ist keine medizinische Beratung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea ChillMate con Face ID o un PIN, mantén todo cifrado en este iPhone y oculta la pantalla con un toque. Ofrece reflexión e información de seguridad de fuentes verificadas. No es consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille ChillMate avec Face ID ou un code, garde tout chiffré sur cet iPhone et masque l'écran en une touche. L'app propose de la réflexion et des informations de sécurité issues de sources vérifiées. Ce n'est pas un avis médical."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendel ChillMate met Face ID of een pincode, houd alles versleuteld op deze iPhone en verberg het scherm met één tik. Het biedt reflectie en veiligheidsinformatie uit geverifieerde bronnen. Het is geen medisch advies."
          }
        }
      }
    },
