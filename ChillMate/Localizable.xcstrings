    "Often contains sildenafil. Avoid with poppers or nitrates because blood pressure can drop dangerously.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält oft Sildenafil. Vermeide es mit Poppers oder Nitraten, da der Blutdruck gefährlich abfallen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A menudo contiene sildenafilo. Evítalo con poppers o nitratos porque la presión arterial puede bajar peligrosamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient souvent du sildénafil. À éviter avec les poppers ou les nitrates, car la tension artérielle peut chuter dangereusement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevat vaak sildenafil. Vermijd met poppers of nitraten omdat de bloeddruk gevaarlijk kan dalen."
          }
        }
      }
    },
    "Okay": {
      "localizations": {
