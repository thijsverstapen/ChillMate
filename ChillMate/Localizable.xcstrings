    "Alpha blockers with Viagra or Kamagra can increase dizziness or fainting risk. Check with a clinician before combining.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alphablocker mit Viagra oder Kamagra können das Risiko für Schwindel oder Ohnmacht erhöhen. Kläre das mit einer Ärztin oder einem Arzt, bevor du kombinierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alfabloqueantes con Viagra o Kamagra pueden aumentar el riesgo de mareo o desmayo. Consulta a un médico antes de combinarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alphabloquants avec du Viagra ou du Kamagra peuvent augmenter le risque de vertiges ou d'évanouissement. Parles-en à un médecin avant de combiner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfablokkers met Viagra of Kamagra kunnen de kans op duizeligheid of flauwvallen vergroten. Overleg met een arts voordat je dit combineert."
          }
        }
      }
    },
