            "state": "translated",
            "value": "Je mag een work in progress zijn."
          }
        }
      }
    },
    "You are allowed to be proud of getting home safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst stolz darauf sein, sicher nach Hause gekommen zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes estar orgulloso de haber llegado a casa a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as le droit d'être fier d'être rentré en sécurité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mag trots zijn dat je veilig thuis bent gekomen."
          }
        }
      }
    },
    "You are allowed to be proud of one good decision.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst stolz auf eine gute Entscheidung sein."
