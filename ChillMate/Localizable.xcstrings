        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je waarde daalt niet als een reeks daalt."
          }
        }
      }
    },
    "Your worth is not measured by how the night goes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert bemisst sich nicht daran, wie der Abend läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu valor no se mide por cómo vaya la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta valeur ne se mesure pas à la façon dont se passe la soirée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je waarde wordt niet afgemeten aan hoe de avond verloopt."
          }
        }
      }
    },
    "Your worth was never on the line tonight.": {
      "localizations": {
        "de": {
