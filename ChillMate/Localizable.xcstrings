    },
    "Every choice that protects your body is worth something, even the small ones." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke keuze die je lichaam beschermt is iets waard, ook de kleine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada decisión que protege tu cuerpo vale algo, incluso las pequeñas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Entscheidung, die deinen Körper schützt, ist etwas wert, auch die kleinen."
          }
        }
      }
    },
    "Everything you saved, in one place" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat je hebt opgeslagen, op één plek"
