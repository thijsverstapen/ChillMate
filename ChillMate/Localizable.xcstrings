          }
        }
      }
    },
    "Risky Chills increased from %lld to %lld compared with the previous 3 weeks. If something changed, tagging it in logs can make patterns easier to see." : {
      "comment" : "A description of the changes in the number of \"Risky Chills\" and the reasons for them.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risky Chills increased from %1$lld to %2$lld compared with the previous 3 weeks. If something changed, tagging it in logs can make patterns easier to see."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risicovolle Chills gestegen van %lld naar %lld vergeleken met de vorige 3 weken. Als er iets veranderde, kan het taggen in logs patronen makkelijker zichtbaar maken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Chills de riesgo aumentaron de %lld a %lld en comparación con las 3 semanas anteriores. Si algo cambió, etiquetarlo en los registros puede facilitar ver los patrones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riskante Chills sind im Vergleich zu den vorherigen 3 Wochen von %lld auf %lld gestiegen. Wenn sich etwas verändert hat, kann das Taggen in den Einträgen Muster sichtbarer machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Chills à risque sont passés de %lld à %lld par rapport aux 3 semaines précédentes. Si quelque chose a changé, l'étiqueter dans les journaux peut faciliter la lecture des schémas."
          }
        }
      }
    },
