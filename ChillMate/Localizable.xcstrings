        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No eres demasiado por pedir lo que te mantiene a salvo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist nicht zu viel, weil du um das bittest, was dich schützt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n'es pas trop parce que tu demandes ce qui te protège."
          }
        }
      }
    },
    "Recovery is less a straight line and more a series of returns." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstel is minder een rechte lijn en meer een reeks terugkeren."
