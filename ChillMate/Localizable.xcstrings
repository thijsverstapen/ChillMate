          "stringUnit": {
            "state": "translated",
            "value": "Alle Informationen zu Wohlbefinden und Schadensminderung in ChillMate stammen aus geprüften, offiziellen Quellen des öffentlichen Gesundheitswesens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la información de bienestar y reducción de daños de ChillMate procede de fuentes oficiales y verificadas de salud pública."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les informations de bien-être et de réduction des risques de ChillMate proviennent de sources de santé publique officielles et vérifiées."
          }
        },
        "nl": {
