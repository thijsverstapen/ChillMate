        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beber agua ahora es un voto por una mañana más fácil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt Wasser zu trinken ist eine Stimme für einen leichteren Morgen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boire de l'eau maintenant, c'est voter pour un matin plus facile."
          }
        }
      }
    },
    "You are allowed to protect your weekend self from your Friday-night self." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag je weekend-zelf beschermen tegen je vrijdagavond-zelf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes proteger a tu yo del fin de semana de tu yo del viernes por la noche."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du darfst dein Wochenend-Ich vor deinem Freitagabend-Ich schützen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as le droit de protéger ton toi du week-end de ton toi du vendredi soir."
          }
        }
      }
    },
    "One steady breath is a place to start again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén rustige ademhaling is een plek om opnieuw te beginnen."
