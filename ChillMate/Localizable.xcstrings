          "stringUnit": {
            "state": "translated",
            "value": "Die automatische verschlüsselte Wiederherstellung auf dem Gerät wird aktualisiert, sobald ChillMate in den Hintergrund wechselt. Letzte Aktualisierung: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic encrypted on-device recovery is updated when ChillMate moves to the background. Last update: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación cifrada automática en el dispositivo se actualiza cuando ChillMate pasa a segundo plano. Última actualización: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération chiffrée automatique sur l'appareil est mise à jour quand ChillMate passe en arrière-plan. Dernière mise à jour : %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch versleuteld herstel op dit apparaat wordt bijgewerkt zodra ChillMate naar de achtergrond gaat. Laatste update: %@."
          }
        }
      }
    },
    "Automatic encrypted on-device recovery starts after you have saved local data and the app has moved to the background once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische verschlüsselte Wiederherstellung startet, sobald du lokale Daten gespeichert hast und die App einmal in den Hintergrund gewechselt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic encrypted on-device recovery starts after you have saved local data and the app has moved to the background once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación cifrada automática empieza cuando hayas guardado datos locales y la app haya pasado a segundo plano una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
