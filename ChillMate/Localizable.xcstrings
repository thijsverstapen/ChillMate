    "No ads, no selling personal information, and no sharing health or sexual-health details for marketing." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen advertenties, geen verkoop van persoonlijke informatie en geen delen van gezondheids- of seksuelegezondheidsgegevens voor marketing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios, sin venta de información personal y sin compartir datos de salud o salud sexual con fines de marketing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, kein Verkauf persönlicher Informationen und keine Weitergabe von Gesundheits- oder Sexualgesundheitsdaten für Marketing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de publicité, pas de vente d'informations personnelles et pas de partage de données de santé ou de santé sexuelle à des fins de marketing."
          }
        }
      }
    },
    "No change reasons tagged yet. New logs now include stress, breakup, work pressure, loneliness, money, housing, conflict, and boredom." : {
      "comment" : "A message displayed when no change reasons have been tagged in logs.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No change reasons tagged yet. New logs now include stress, breakup, work pressure, loneliness, money, housing, conflict, and boredom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen veranderingsredenen getagd. Nieuwe logs bevatten nu stress, relatiebreuk, werkdruk, eenzaamheid, geld, huisvesting, conflict en verveling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se han etiquetado motivos de cambio. Los nuevos registros ahora incluyen estrés, ruptura, presión laboral, soledad, dinero, vivienda, conflicto y aburrimiento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Veränderungsgründe getaggt. Neue Einträge enthalten jetzt Stress, Trennung, Arbeitsdruck, Einsamkeit, Geld, Wohnen, Konflikt und Langeweile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun motif de changement n'est encore étiqueté. Les nouveaux journaux incluent désormais le stress, la rupture, la pression au travail, la solitude, l'argent, le logement, le conflit et l'ennui."
          }
        }
      }
    },
    "No Chill has been logged today. Add one only if there is something worth saving." : {
