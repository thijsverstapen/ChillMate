        }
      }
    },
    "Your needs are not too much to take seriously.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bedürfnisse sind nicht zu viel, um ernst genommen zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus necesidades no son demasiado como para tomarlas en serio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
