    "Your worth does not drop when a streak does.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert sinkt nicht, wenn eine Serie endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu valor no baja cuando baja una racha."
