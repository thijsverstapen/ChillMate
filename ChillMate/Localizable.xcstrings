    "One of your selections can affect serotonin levels. Risk can increase with repeated use, heat, dehydration, or other medication." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een van je keuzes kan de serotoninespiegel beïnvloeden. Het risico kan toenemen bij herhaald gebruik, hitte, uitdroging of andere medicatie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de tus selecciones puede afectar a los niveles de serotonina. El riesgo puede aumentar con el uso repetido, el calor, la deshidratación u otra medicación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine deiner Auswahlen kann den Serotoninspiegel beeinflussen. Das Risiko kann bei wiederholtem Konsum, Hitze, Dehydrierung oder anderen Medikamenten steigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'une de tes sélections peut affecter les niveaux de sérotonine. Le risque peut augmenter avec un usage répété, la chaleur, la déshydratation ou d'autres médicaments."
          }
        }
      }
    },
